{
  "name": "@reponova/lang-c-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared C-family extractor and outline for @reponova/lang-c and @reponova/lang-cpp (workspace-internal, never published to npm).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "pnpm -w grammar-fetch --package=lang-c",
    "test": "vitest run",
    "test:coverage": "pnpm -w grammar-fetch --package=lang-c && vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "reponova": "^0.6.0"
  },
  "devDependencies": {
    "@reponova/lang-test-utils": "workspace:*",
    "web-tree-sitter": "^0.25.10"
  },
  "license": "MIT"
}
