{
  "name": "@reponova/lang-plantuml",
  "version": "0.2.0",
  "description": "PlantUML support for RepoNova",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "reponova": "^0.4.0"
  },
  "devDependencies": {
    "@reponova/lang-test-utils": "workspace:*",
    "reponova": "^0.4.3"
  },
  "reponova": {
    "type": "language",
    "id": "plantuml",
    "extensions": [
      ".puml",
      ".plantuml"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristianoCiuti/reponova-langs.git",
    "directory": "packages/lang-plantuml"
  },
  "homepage": "https://github.com/CristianoCiuti/reponova-langs/tree/main/packages/lang-plantuml"
}
