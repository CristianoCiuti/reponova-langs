{
  "name": "@reponova/lang-svg",
  "version": "0.3.0",
  "description": "SVG asset support for RepoNova",
  "keywords": [
    "reponova",
    "reponova-plugin",
    "language-plugin",
    "svg",
    "diagram",
    "vector-graphics",
    "icon",
    "asset",
    "knowledge-graph",
    "static-analysis"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "reponova": "^0.4.0"
  },
  "devDependencies": {
    "@reponova/lang-test-utils": "workspace:*",
    "reponova": "^0.4.3"
  },
  "reponova": {
    "type": "language",
    "id": "svg",
    "extensions": [
      ".svg"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristianoCiuti/reponova-langs.git",
    "directory": "packages/lang-svg"
  },
  "homepage": "https://github.com/CristianoCiuti/reponova-langs/tree/main/packages/lang-svg"
}
