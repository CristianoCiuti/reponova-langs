{
  // Shared compiler options imported by every workspace tsconfig.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "paths": {
      "@core/*": ["./packages/core/src/*"],
      "@web/*": ["./apps/web/src/*"]
    }
  }
}
