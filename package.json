{
  "name": "reponova-langs",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for official RepoNova language plugins (@reponova/lang-*)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "node scripts/install-githooks.mjs",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./tools/bootstrap-plugin\" --filter \"./tools/trust-configure\" test",
    "test:coverage": "pnpm --filter \"@reponova/lang-python\" --filter \"@reponova/lang-plantuml\" --filter \"@reponova/lang-svg\" --filter \"@reponova/lang-json\" --filter \"@reponova/lang-typescript-core\" test:coverage",
    "size": "pnpm --filter \"@reponova/lang-python\" --filter \"@reponova/lang-javascript\" --filter \"@reponova/lang-typescript\" --filter \"@reponova/lang-tsx\" --filter \"@reponova/lang-json\" --filter \"@reponova/lang-plantuml\" --filter \"@reponova/lang-svg\" size",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "lint": "eslint packages tools",
    "lint:fix": "eslint packages tools --fix",
    "scaffold": "pnpm --filter @reponova/scaffold start --",
    "grammar-fetch": "pnpm --filter @reponova/grammar-fetcher start --",
    "grammar-check": "pnpm --filter @reponova/grammar-fetcher start -- --check",
    "trust:configure": "pnpm --filter @reponova/trust-configure start --",
    "bootstrap-plugin": "pnpm --filter @reponova/bootstrap-plugin start --",
    "dev:link-reponova": "node scripts/dev-link-reponova.mjs",
    "dev:unlink-reponova": "node scripts/dev-unlink-reponova.mjs",
    "check:no-dev-link": "node scripts/check-no-dev-link.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prerelease": "node scripts/check-no-dev-link.mjs",
    "release": "pnpm grammar-fetch && pnpm build && pnpm test && changeset publish",
    "clean": "pnpm -r exec rimraf dist node_modules && rimraf node_modules .dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.39.4",
    "@size-limit/file": "^12.1.0",
    "@types/node": "^20.16.0",
    "@vitest/coverage-v8": "~2.1.9",
    "eslint": "^9.13.0",
    "globals": "^17.6.0",
    "rimraf": "^6.0.1",
    "size-limit": "^12.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.1.0",
    "web-tree-sitter": "^0.25.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristianoCiuti/reponova-langs.git"
  },
  "homepage": "https://github.com/CristianoCiuti/reponova-langs"
}
