{
  "name": "reponova-langs",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for official RepoNova language plugins (@reponova/lang-*)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "lint": "eslint packages tools",
    "lint:fix": "eslint packages tools --fix",
    "scaffold": "pnpm --filter @reponova/scaffold start --",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish",
    "clean": "pnpm -r exec rimraf dist node_modules && rimraf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.16.0",
    "eslint": "^9.13.0",
    "globals": "^17.6.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.1.0",
    "web-tree-sitter": "^0.25.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristianoCiuti/reponova-langs.git"
  },
  "homepage": "https://github.com/CristianoCiuti/reponova-langs"
}
